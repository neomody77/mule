HOST=0.0.0.0
PORT=8000
DEBUG=true
WORKSPACE_BASE_DIR=/tmp/workspace
DATA_DIR=./data
API_TOKENS=your-api-token-here
WS_HEARTBEAT_INTERVAL=30

# Agent 后端配置: claude, sandbox, adk
# - claude: 直接使用 Claude Agent SDK (需要系统已登录 Claude)
# - sandbox: Docker 沙箱隔离执行 (需要构建 mule-workspace 镜像)
# - adk: Google ADK Agent
AGENT_BACKEND=claude

# Docker 沙箱配置 (仅当 AGENT_BACKEND=sandbox 时使用)
SANDBOX_IMAGE=mule-workspace:latest

# GitHub CLI 配置传递 (仅当 AGENT_BACKEND=sandbox 时使用)
# 设为 true 将宿主机的 gh 认证信息传递给容器，允许容器内执行 gh 命令
SHARE_GH_CONFIG=false

# Google ADK 配置 (仅当 AGENT_BACKEND=adk 时使用)
ADK_MODEL=gemini-2.0-flash
